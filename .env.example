# ── Soundtrackd v2 environment ─────────────────────────────────────────
# Copy to .env for local dev. In production, set these in Netlify → Site settings → Environment variables.
# Anything prefixed PUBLIC_ is shipped to the browser. Everything else stays on the server.

# Supabase (public — safe in the browser)
PUBLIC_SUPABASE_URL=https://cmjemqmxnpusluzyiwyj.supabase.co
PUBLIC_SUPABASE_KEY=sb_publishable_2w5SVBrYjBEWbJ8Rw3GRbQ_Z-EVXQ41

# Canonical site URL (used for OAuth redirects and absolute links)
PUBLIC_SITE_URL=http://localhost:5173

# Supabase secret key — SERVER ONLY. Supabase dashboard → Project Settings → API keys → "secret" (or legacy service_role).
# Required for the catalogue module (it is the only thing allowed to write catalog_items) and for background jobs.
SUPABASE_SECRET_KEY=

# Last.fm (charts/trending; non-commercial use only — see REBUILD-SPEC §6.1)
LASTFM_API_KEY=c04398910fb731d86c172d1a8e658d4a

# MusicBrainz asks for a descriptive User-Agent with a contact address
MUSICBRAINZ_CONTACT=hello@soundtrackd.org

# Shared secret that protects the /api/jobs/* endpoints (MBID backfill, v1 backfill, now-playing poller).
# Generate one with:  openssl rand -hex 32
JOBS_SECRET=

# Supporter tier (§13.2B) — Lemon Squeezy hosted checkout + webhook
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Affiliate tags (§13.2A). Leave blank and links degrade to plain search URLs.
AFFILIATE_AMAZON_TAG=
AFFILIATE_TICKETMASTER_TAG=
